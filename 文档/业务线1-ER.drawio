        </mxCell>
        <mxCell id="note2" value="落库映射：家属绑定 → sys_user.elder_id；对应老人 → family_notification.elder_id；发送 → sender_id；接收 → recipient_id。" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#455a64;" vertex="1" parent="1">
          <mxGeometry x="80" y="1780" width="2740" height="38" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="唯一约束：(recipient_id, elder_id, reminder_key, sent_date)。此页展示老人和账号的相关属性；老人完整属性见第一页，账号认证字段见系统用户数据字典。" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;fontColor=#455a64;" vertex="1" parent="1">
